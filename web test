<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="theme-color" content="#0b6b4f" />
  <title>Leader Pharma Manager Pro V1.4</title>
  <link rel="stylesheet" href="styles.css" />
</head>
<body>

  <div id="loginView" class="center-screen">
    <div class="login-card">
      <div class="brand-mark">✚</div>
      <h1>Leader Pharma</h1>
      <img src="leader-pharma-logo.png" alt="Logo Leader Pharma" class="brand-logo login-logo">
      <p class="subtitle">Manager Pro V1.4 DG DEV</p>
      <div class="legal-id">
        N° Impôt : A2311751Z<br>
        RCCM : CD/KNA/RCCM/25-A-593<br>
        Adresse : Route Kanyama, Réf. HGR Kamina — Kamina
      </div>
      <label>Agence</label>
      <select id="loginAgency"></select>
      <label>Utilisateur</label>
      <input id="username" value="leader.fr" autocomplete="username" />
      <label>Mot de passe</label>
      <input id="password" type="password" value="1234" autocomplete="current-password" />
      <button id="loginBtn">Se connecter</button>
      <p id="loginError" class="error"></p>
      <small>Connexion sécurisée Leader Pharma</small>
    </div>
  </div>

  <div id="appView" class="app hidden">
    <aside class="sidebar">
      <div class="logo-wrap">
        <div class="brand-mark small">✚</div>
        <img src="leader-pharma-logo.png" alt="Logo Leader Pharma" class="brand-logo sidebar-logo">
        <div>
          <strong>LEADER PHARMA</strong>
          <span>Manager Pro</span>
          <small class="sidebar-legal">
            Impôt A2311751Z<br>
            RCCM CD/KNA/RCCM/25-A-593
          </small>
        </div>
      </div>
      <nav id="nav"></nav>
      <div class="side-footer">
        <span id="currentAgencyLabel"></span>
        <button id="logoutBtn" class="ghost">Déconnexion / Changer d’utilisateur</button>
      </div>
    </aside>

    <main class="main">
      <header class="topbar">
        <div>
          <h2 id="pageTitle">Tableau de bord</h2>
          <p id="pageHint">Vue synthétique de votre pharmacie</p>
        </div>
        <div class="top-actions">
          <select id="agencySwitcher"></select>
          <button id="backupBtn" class="secondary">Sauvegarder</button>
          <label class="restore-label">
            Restaurer
            <input id="restoreInput" type="file" accept="application/json" />
          </label>
        </div>
      </header>
      <section id="content"></section>
    </main>
  </div>

  <div id="toast" class="toast"></div>

  <script src="app.js"></script>
  <script src="dg-security.js"></script>

  <script>
  /* LEADER PHARMA F29.6.0.17 - MENU DG + POINTAGE 24H + TABLEAU DG UNIQUE */
  (function(){
    'use strict';
    if(window.__LP_F296017_FINAL_FIX__) return;
    window.__LP_F296017_FINAL_FIX__=true;

    const MARK='LEADER PHARMA F29.6.0.17 MENU DG PC WINDOWS STABLE V6 + POINTAGE 24H ACTIF';
    const PENDING='lp_f296017_exit_photo_pending_v2';
    let busy=false,timer=null;

    const txt=v=>String(v==null?'':v).trim();
    const norm=v=>{try{return txt(v).toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g,'')}catch(e){return txt(v).toLowerCase()}};

    function isDG(){
      try{
        let byUser=false;
        if(typeof currentUser!=='undefined'&&currentUser){
          const r=norm(currentUser.role),u=norm(currentUser.username||currentUser.user||currentUser.login),n=norm(currentUser.name);
          byUser=(r==='dg'||r.includes('direction')||r.includes('directeur')||u==='leader.fr'||n.includes('direction generale')||n.includes('directeur'));
        }
        const foot=norm(document.getElementById('currentAgencyLabel')?.textContent||'');
        const title=norm(document.getElementById('pageTitle')?.textContent||'');
        const byScreen=/(^|[^a-z0-9])dg([^a-z0-9]|$)/.test(foot)||foot.includes('direction')||title.includes('direction');
        return byUser||byScreen;
      }catch(e){return false}
    }

    function style(){
      if(document.getElementById('lp-f296017-style'))return;
      const s=document.createElement('style');
      s.id='lp-f296017-style';
      s.textContent=`
      /* MENU DG PC/WINDOWS : reprise du comportement stable valide V5 */
      @media(min-width:981px){
        body #appView.lp-f296017-app{grid-template-columns:350px minmax(0,1fr)!important}
        body #appView.lp-f296017-app .sidebar.lp-f296017-sidebar{
          position:sticky!important;top:0!important;
          width:350px!important;min-width:350px!important;max-width:350px!important;
          height:100vh!important;min-height:100vh!important;
          padding:12px 10px!important;
          overflow-y:auto!important;overflow-x:hidden!important;
          scrollbar-gutter:stable
        }
        body #appView.lp-f296017-app #nav.lp-f296017-nav{
          display:grid!important;
          grid-template-columns:minmax(0,1fr) minmax(0,1fr)!important;
          width:100%!important;max-width:100%!important;min-width:0!important;
          gap:3px 5px!important;align-content:start!important;overflow-x:hidden!important
        }
        body #appView.lp-f296017-app #nav.lp-f296017-nav .nav-btn{
          display:block!important;visibility:visible!important;opacity:1!important;
          width:100%!important;max-width:100%!important;min-width:0!important;
          padding:8px 7px!important;font-size:12.5px!important;line-height:1.18!important;
          white-space:normal!important;overflow-wrap:anywhere!important
        }
        body #appView.lp-f296017-app .sidebar.lp-f296017-sidebar .side-footer{
          display:grid!important;margin-top:8px!important;gap:7px!important;flex-shrink:0!important
        }
        body #appView.lp-f296017-app .sidebar.lp-f296017-sidebar .logo-wrap{
          padding:2px 6px 10px!important;gap:7px!important
        }
        body #appView.lp-f296017-app .sidebar.lp-f296017-sidebar .sidebar-logo{
          width:44px!important;height:44px!important;margin-right:4px!important
        }
        body #appView.lp-f296017-app .sidebar.lp-f296017-sidebar .logo-wrap strong{
          font-size:14px!important
        }
      }
      @media(max-width:980px){
        body .sidebar.lp-f296017-sidebar{position:relative!important;height:auto!important;min-height:auto!important;max-height:none!important;overflow:visible!important}
        body #nav.lp-f296017-nav{display:grid!important;grid-template-columns:repeat(2,minmax(0,1fr))!important;gap:6px!important;align-content:start!important}
        body #nav.lp-f296017-nav .nav-btn{display:block!important;visibility:visible!important;opacity:1!important;min-width:0!important;white-space:normal!important}
      }
      .lp-f296017-hide{display:none!important}`;
      document.head.appendChild(s);
    }

    function menu(){
      const app=document.getElementById('appView'),side=document.querySelector('.sidebar'),nav=document.getElementById('nav');
      if(!isDG()){
        if(app)app.classList.remove('lp-f296017-app');
        if(side)side.classList.remove('lp-f296017-sidebar');
        if(nav)nav.classList.remove('lp-f296017-nav');
        return;
      }
      if(app)app.classList.add('lp-f296017-app');
      if(side)side.classList.add('lp-f296017-sidebar');
      if(nav)nav.classList.add('lp-f296017-nav');
    }

    function findHeading(root,needle){
      const n=norm(needle),els=root.querySelectorAll('h1,h2,h3,h4,h5,strong,b');
      for(const el of els)if(norm(el.textContent).includes(n))return el;
      return null;
    }

    function oneTable(){
      document.querySelectorAll('.lp-f296017-hide').forEach(el=>el.classList.remove('lp-f296017-hide'));
      if(!isDG())return;
      const c=document.getElementById('content')||document.querySelector('main');
      if(!c)return;
      const full=findHeading(c,'controle dg des pointages photo');
      const simple=findHeading(c,'presences / pointage');
      if(!full||!simple)return;
      simple.classList.add('lp-f296017-hide');
      let el=simple.nextElementSibling;
      while(el){
        if(/^H[1-6]$/.test(el.tagName))break;
        if(el.tagName==='TABLE'||(el.querySelector&&el.querySelector('table'))){el.classList.add('lp-f296017-hide');break}
        el=el.nextElementSibling;
      }
    }

    function domFix(){
      clearTimeout(timer);
      timer=setTimeout(()=>{style();menu();oneTable()},50);
    }

    function userVals(){
      try{return [currentUser?.username,currentUser?.login,currentUser?.user,currentUser?.id,currentUser?.name].map(norm).filter(Boolean)}catch(e){return []}
    }
    function ownerVals(r){return [r?.lpUser,r?.username,r?.user,r?.login,r?.employeeId,r?.name].map(norm).filter(Boolean)}
    function sameUser(r){const a=userVals(),b=ownerVals(r);return a.length&&b.some(v=>a.includes(v))}
    function agency(){try{return txt(typeof currentAgency!=='undefined'?currentAgency:'')}catch(e){return ''}}
    function sameAgency(r){const a=norm(agency()),b=norm(r&&(r.agency||r.agence));return !a||!b||a===b}
    function photo(v){return typeof v==='string'&&v.length>100}
    function rows(){try{return typeof db!=='undefined'&&db&&Array.isArray(db.attendance)?db.attendance:[]}catch(e){return []}}
    function recent(d){try{const x=new Date(txt(d)+'T12:00:00');return Number.isNaN(x.getTime())||Math.abs(Date.now()-x.getTime())<=3*86400000}catch(e){return true}}

    function exitRow(dataUrl){
      const a=rows().slice().reverse().filter(r=>r&&sameUser(r)&&sameAgency(r)&&recent(r.date));
      return a.find(r=>photo(r.exitPhoto)&&r.exitPhoto===dataUrl)||a.find(r=>txt(r.exit)&&!photo(r.exitPhoto))||a.find(r=>txt(r.exit))||null;
    }

    function persist(){
      try{if(typeof save==='function')save();else if(typeof db!=='undefined'&&db)localStorage.setItem('lpmp_v13',JSON.stringify(db))}
      catch(e){try{if(typeof db!=='undefined'&&db)localStorage.setItem('lpmp_v13',JSON.stringify(db))}catch(_e){}}
    }

    function makePending(r){
      if(!r)return null;
      return {rowId:txt(r.id||r.uuid||''),date:txt(r.date),agency:txt(r.agency||r.agence||agency()),users:Array.from(new Set(userVals().concat(ownerVals(r)).filter(Boolean))),tries:0,createdAt:new Date().toISOString()};
    }
    function savePending(p){try{localStorage.setItem(PENDING,JSON.stringify(p))}catch(e){}}
    function loadPending(){try{const p=JSON.parse(localStorage.getItem(PENDING)||'null');return p&&typeof p==='object'?p:null}catch(e){return null}}
    function clearPending(){try{localStorage.removeItem(PENDING)}catch(e){}}
    function match(r,p){
      if(!r||!p)return false;
      if(p.rowId&&txt(r.id||r.uuid||'')===p.rowId)return true;
      if(txt(r.date)!==txt(p.date)||norm(r.agency||r.agence)!==norm(p.agency))return false;
      const o=ownerVals(r),u=Array.isArray(p.users)?p.users.map(norm).filter(Boolean):[];
      return o.some(v=>u.includes(v));
    }
    function localRow(p){return rows().find(r=>match(r,p))||null}

    async function remoteHas(p){
      try{
        if(typeof __lpRemoteMeta!=='function')return false;
        const m=await __lpRemoteMeta(),remote=m&&m.rows&&m.rows[0]&&m.dataCol?m.rows[0][m.dataCol]:null;
        const rr=remote&&Array.isArray(remote.attendance)?remote.attendance.find(r=>match(r,p)):null;
        return !!(rr&&photo(rr.exitPhoto)&&txt(rr.exit));
      }catch(e){return false}
    }

    async function syncExit(){
      if(busy||isDG())return false;
      const p=loadPending();
      if(!p)return true;
      const r=localRow(p);
      if(!r||!photo(r.exitPhoto))return false;
      busy=true;
      try{
        persist();
        p.tries=Number(p.tries||0)+1;p.lastTryAt=new Date().toISOString();savePending(p);
        if(typeof syncPush==='function')await syncPush();
        if(await remoteHas(p)){
          clearPending();
          try{if(typeof toast==='function')toast('Départ + photo synchronisés au DG')}catch(e){}
          return true;
        }
        return false;
      }catch(e){console.warn('F29.6.0.17 PHOTO DEPART 24H',e);return false}
      finally{busy=false}
    }

    function scheduleSync(){[0,1000,3000,8000,20000,45000].forEach(d=>setTimeout(syncExit,d))}

    function armExit(type,dataUrl){
      if(isDG()||type!=='exit'||!photo(dataUrl))return;
      const r=exitRow(dataUrl);if(!r)return;
      r.exitPhoto=dataUrl;
      if(!txt(r.exitPhotoAt))r.exitPhotoAt=txt(r.exit)||new Date().toLocaleTimeString('fr-FR',{hour:'2-digit',minute:'2-digit'});
      r._lpAttendanceUpdatedAt=new Date().toISOString();
      persist();
      const p=makePending(r);if(p){savePending(p);scheduleSync()}
    }

    const prev=typeof window.lpF2946PhotoReady==='function'?window.lpF2946PhotoReady:null;
    if(prev&&!prev.__lpF296017Wrapped){
      const wrapped=function(type,dataUrl){let out;try{out=prev.apply(this,arguments)}catch(e){console.warn(e)}try{armExit(type,dataUrl)}catch(e){console.warn(e)}return out};
      wrapped.__lpF296017Wrapped=true;
      window.lpF2946PhotoReady=wrapped;
    }

    function recover(){
      if(isDG())return;
      const r=rows().slice().reverse().find(x=>x&&sameUser(x)&&sameAgency(x)&&recent(x.date)&&txt(x.exit)&&photo(x.exitPhoto));
      if(!r)return;
      const p=makePending(r);if(p){savePending(p);scheduleSync()}
    }

    style();domFix();
    try{new MutationObserver(domFix).observe(document.documentElement,{childList:true,subtree:true})}catch(e){}
    window.addEventListener('resize',domFix);
    window.addEventListener('online',()=>{domFix();setTimeout(syncExit,300)});
    document.addEventListener('visibilitychange',()=>{if(!document.hidden){domFix();setTimeout(syncExit,400)}});
    setTimeout(domFix,300);setTimeout(domFix,1000);setTimeout(recover,1600);
    setInterval(()=>{if(loadPending())syncExit()},30000);

    window.lpF296017FixDGMenu=menu;
    window.lpF296017FixDGAttendance=oneTable;
    window.lpF296017SyncPendingExitPhoto=syncExit;
    window.lpF296017RecoverLatestExitPhoto=recover;
    window.lpF296017Marker=MARK;
    try{console.log(MARK)}catch(e){}
  })();
  </script>

</body>
</html>
